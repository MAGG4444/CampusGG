{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@nestjs/typeorm$": "<rootDir>/__mocks__/@nestjs/typeorm.ts",
    "^@nestjs/config$": "<rootDir>/__mocks__/@nestjs/config.ts"
  }
}
