# Database (PostgreSQL)
# Local development: docker compose up -d
DATABASE_URL="postgresql://campusgg:campusgg_dev@localhost:5432/campusgg?schema=public"

# AWS RDS / managed PostgreSQL:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/campusgg?sslmode=require"
#   DATABASE_SSL=true
#   DATABASE_SSL_REJECT_UNAUTHORIZED=true
#   DATABASE_SSL_CA="./global-bundle.pem"   # optional RDS CA bundle
# Set DATABASE_SSL_REJECT_UNAUTHORIZED=false only when no CA bundle is available.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Application
PORT=3000
NODE_ENV=development
APP_BASE_URL="http://localhost:3000"

# Matchmaking (milliseconds unless noted)
# Clients poll match-status every few seconds; the heartbeat keeps queued rows alive.
MATCHMAKING_TICK_INTERVAL_MS=3000
MATCHMAKING_HEARTBEAT_TIMEOUT_MS=120000
MATCHMAKING_RESULT_TTL_MS=300000
MATCHMAKING_BATCH_SIZE=1000
MATCHMAKING_SEARCH_WINDOW=15

# Email Delivery (Leave SMTP_HOST empty for local dev console-logging fallback)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="CampusGG <noreply@campusgg.edu>"

# Redis (Optional AWS ElastiCache / local cache)
REDIS_ENABLED=false
REDIS_HOST="localhost"
REDIS_PORT=6379
